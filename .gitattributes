# Git attributes for CALION repository

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Jupyter Notebooks: Strip outputs automatically
*.ipynb filter=nbstripout
*.ipynb diff=ipynb

# Python files
*.py text eol=lf
*.pyx text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# Configuration files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pyc binary
*.so binary
*.dylib binary

# Export LFS-tracked files (if using Git LFS)
# *.xlsx filter=lfs diff=lfs merge=lfs -text
# *.pdf filter=lfs diff=lfs merge=lfs -text

# Diff settings
*.ipynb diff=ipynb
*.json diff=json

# Merge settings
*.ipynb merge=nbstripout
