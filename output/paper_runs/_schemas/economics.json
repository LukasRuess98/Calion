{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "economics.csv",
  "description": "Single-row KPI table per run (§3.2)",
  "type": "object",
  "required": [
    "cost_total_eur", "cost_energy_buy_eur", "revenue_sell_eur",
    "cost_fuel_eur", "cost_co2_eur", "cost_dump_eur",
    "cost_demand_charge_eur", "cost_pump_eur",
    "energy_buy_MWh", "energy_sell_MWh", "gas_consumption_MWh",
    "co2_total_t", "co2_grid_t", "co2_fuel_t",
    "peak_import_MW", "peak_export_MW",
    "lcoh_eur_per_MWh_th", "share_HP_pct", "share_CHP_pct", "share_EK_pct"
  ],
  "properties": {
    "cost_total_eur":           {"type": "number"},
    "cost_energy_buy_eur":      {"type": "number"},
    "revenue_sell_eur":         {"type": "number"},
    "cost_fuel_eur":            {"type": "number"},
    "cost_co2_eur":             {"type": "number"},
    "cost_dump_eur":            {"type": "number"},
    "cost_demand_charge_eur":   {"type": "number"},
    "cost_pump_eur":            {"type": "number"},
    "energy_buy_MWh":           {"type": "number", "minimum": 0},
    "energy_sell_MWh":          {"type": "number", "minimum": 0},
    "gas_consumption_MWh":      {"type": "number", "minimum": 0},
    "co2_total_t":              {"type": "number"},
    "co2_grid_t":               {"type": "number"},
    "co2_fuel_t":               {"type": "number"},
    "peak_import_MW":           {"type": "number", "minimum": 0},
    "peak_export_MW":           {"type": "number", "minimum": 0},
    "lcoh_eur_per_MWh_th":      {"type": "number"},
    "share_HP_pct":             {"type": "number", "minimum": 0, "maximum": 100},
    "share_CHP_pct":            {"type": "number", "minimum": 0, "maximum": 100},
    "share_EK_pct":             {"type": "number", "minimum": 0, "maximum": 100}
  }
}
