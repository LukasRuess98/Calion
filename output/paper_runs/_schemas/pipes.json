{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pipes.csv",
  "description": "One row per pipe — static network properties and annual KPIs (§3.4)",
  "type": "object",
  "required": [
    "pipe_id", "from", "to", "length_m", "diameter_mm",
    "u_value_supply_w_per_m_k", "u_value_return_w_per_m_k",
    "R_resistance", "m_dot_max_kg_s", "v_max_m_s",
    "dp_max_Pa", "transport_delay_min", "k_p_steps",
    "annual_loss_MWh", "annual_loss_share_pct",
    "peak_velocity_m_s", "peak_dp_bar", "annual_pump_energy_MWh"
  ],
  "properties": {
    "pipe_id":                      {"type": "string"},
    "from":                         {"type": "string"},
    "to":                           {"type": "string"},
    "length_m":                     {"type": "number", "minimum": 0},
    "diameter_mm":                  {"type": "number", "minimum": 0},
    "u_value_supply_w_per_m_k":    {"type": "number", "minimum": 0},
    "u_value_return_w_per_m_k":    {"type": "number", "minimum": 0},
    "R_resistance":                 {"type": "number"},
    "m_dot_max_kg_s":              {"type": "number", "minimum": 0},
    "v_max_m_s":                   {"type": "number", "minimum": 0},
    "dp_max_Pa":                   {"type": "number", "minimum": 0},
    "transport_delay_min":         {"type": "number", "minimum": 0},
    "k_p_steps":                   {"type": "integer", "minimum": 1},
    "annual_loss_MWh":             {"type": "number", "minimum": 0},
    "annual_loss_share_pct":       {"type": "number", "minimum": 0},
    "peak_velocity_m_s":           {"type": "number", "minimum": 0},
    "peak_dp_bar":                 {"type": "number", "minimum": 0},
    "annual_pump_energy_MWh":      {"type": "number", "minimum": 0}
  }
}
