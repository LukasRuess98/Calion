{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "meta.json",
  "description": "Run metadata (§3.1)",
  "type": "object",
  "required": [
    "run_id", "config_path", "git_sha", "solve_time_s", "mip_gap",
    "objective", "num_vars", "num_bin", "num_constr", "model_class", "wall_clock"
  ],
  "properties": {
    "run_id":         {"type": "string"},
    "config_path":    {"type": "string"},
    "git_sha":        {"type": "string"},
    "gurobi_version": {"type": ["string", "null"]},
    "solve_time_s":   {"type": "number", "minimum": 0},
    "mip_gap":        {"type": ["number", "null"]},
    "objective":      {"type": "number"},
    "num_vars":       {"type": ["integer", "null"]},
    "num_bin":        {"type": ["integer", "null"]},
    "num_constr":     {"type": ["integer", "null"]},
    "num_quad_constr":{"type": ["integer", "null"]},
    "model_class":    {"type": "string", "enum": ["MILP", "MIQCP", "unknown"]},
    "wall_clock":     {"type": "string"},
    "peak_RAM_GB":    {"type": ["number", "null"]}
  }
}
