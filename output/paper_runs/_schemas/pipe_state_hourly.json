{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pipe_state_hourly.parquet",
  "description": "Long-format hourly pipe state, T*P rows (§3.5)",
  "type": "object",
  "required": [
    "timestamp", "pipe_id",
    "Q_pipe_MW", "m_dot_kg_s", "dp_Pa",
    "T_in_C", "T_out_C", "P_pump_pipe_MW", "Q_loss_pipe_MW"
  ],
  "properties": {
    "timestamp":       {"type": "string", "format": "date-time"},
    "pipe_id":         {"type": "string"},
    "Q_pipe_MW":       {"type": "number"},
    "m_dot_kg_s":      {"type": "number", "minimum": 0},
    "dp_Pa":           {"type": "number", "minimum": 0},
    "T_in_C":          {"type": "number"},
    "T_out_C":         {"type": "number"},
    "P_pump_pipe_MW":  {"type": "number", "minimum": 0},
    "Q_loss_pipe_MW":  {"type": "number", "minimum": 0}
  }
}
