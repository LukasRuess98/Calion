\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Model scope grid. Legend: --~none, A~aggregated, \checkmark  ~present, PWL~piecewise-linear, Bil/Quad~native nonlinear, exo~exogenous. Columns left to right: four decomposition controls then the monotone fidelity ladder. The controls, $\ensuremath  {\mathrm  {L1}}$ and $\ensuremath  {\mathrm  {L3}}$ are solved (MILP, $\le $0.01\,\% gap); temperature propagation ($\ensuremath  {\mathrm  {L2}}$), station hydraulics ($\ensuremath  {\mathrm  {L4}}$,$\ensuremath  {\mathrm  {L5}}$) and the nonlinear reference (NL) are non-convex and are quantified by the validated forward evaluator rather than solved.}}{11}{table.18}\protected@file@percent }
\newlabel{tab:designgrid}{{18}{11}{Model scope grid. Legend: --~none, A~aggregated, \checkmark ~present, PWL~piecewise-linear, Bil/Quad~native nonlinear, exo~exogenous. Columns left to right: four decomposition controls then the monotone fidelity ladder. The controls, $\Lone $ and $\Lthree $ are solved (MILP, $\le $0.01\,\% gap); temperature propagation ($\Ltwo $), station hydraulics ($\Lfour $,$\Lfive $) and the nonlinear reference (NL) are non-convex and are quantified by the validated forward evaluator rather than solved}{table.18}{}}
