\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Balanced-design analysis of variance of the loss burden across the 135 synthetic networks (full $3\times 5\times 3\times 3$ factorial, so the sums of squares are unambiguous). Trunk pipe length dominates; the loss main effect is $\ge $97\,\% of the cost gap on every network regardless of factor, and the topology main effect stays within $\pm $2.4\,\%, so the decomposition conclusion is a property of the design, not of any one factor level.}}{27}{table.caption.28}\protected@file@percent }
\newlabel{tab:synthanova}{{10}{27}{Balanced-design analysis of variance of the loss burden across the 135 synthetic networks (full $3\times 5\times 3\times 3$ factorial, so the sums of squares are unambiguous). Trunk pipe length dominates; the loss main effect is $\ge $97\,\% of the cost gap on every network regardless of factor, and the topology main effect stays within $\pm $2.4\,\%, so the decomposition conclusion is a property of the design, not of any one factor level}{table.caption.28}{}}
