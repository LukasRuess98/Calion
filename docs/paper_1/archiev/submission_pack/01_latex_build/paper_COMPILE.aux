\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Forward supply-temperature sensitivity on $\ensuremath  {\mathrm  {L1}}$: lowering the plant supply temperature by $\Delta T_\text  {sup}$ cuts loss cost but raises pumping. Cost-optimal reduction marked $^{\star }$; the velocity limit binds at 20\,K. Loss valued at the marginal unit (upper bound). Costs in EUR/yr.}}{16}{table.caption.35}\protected@file@percent }
\newlabel{tab:tsup}{{11}{16}{Forward supply-temperature sensitivity on $\Lone $: lowering the plant supply temperature by $\Delta T_\text {sup}$ cuts loss cost but raises pumping. Cost-optimal reduction marked $^{\star }$; the velocity limit binds at 20\,K. Loss valued at the marginal unit (upper bound). Costs in EUR/yr}{table.caption.35}{}}
