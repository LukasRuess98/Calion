\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Estimation bias versus decision regret (\% of the baseline $\ensuremath  {\mathrm  {L1}}$ operating cost, forward evaluator), with the \emph  {decision} each model drove. Regret is shown for three shortfall-pricing schemes -- top-up at the marginal unit, the peak unit, and unmet demand penalised at the dump price. \emph  {Viol.} is physical-feasibility violations (velocity, differential pressure, unmet). The last two columns are the resulting dispatch: heat-pump energy share and running hours. The copperplate, blind to network loss, under-provisions the heat pump ($77.9$\,\%, 2063\,h) relative to the loss-aware node-resolved levels ($87.8$\,\%, $\sim $2310\,h), and pays the shortfall at the margin in winter hours it never planned for -- which is what the $+46$\,\% regret \emph  {is}, physically.}}{15}{table.caption.31}\protected@file@percent }
\newlabel{tab:regret}{{9}{15}{Estimation bias versus decision regret (\% of the baseline $\Lone $ operating cost, forward evaluator), with the \emph {decision} each model drove. Regret is shown for three shortfall-pricing schemes -- top-up at the marginal unit, the peak unit, and unmet demand penalised at the dump price. \emph {Viol.} is physical-feasibility violations (velocity, differential pressure, unmet). The last two columns are the resulting dispatch: heat-pump energy share and running hours. The copperplate, blind to network loss, under-provisions the heat pump ($77.9$\,\%, 2063\,h) relative to the loss-aware node-resolved levels ($87.8$\,\%, $\sim $2310\,h), and pays the shortfall at the margin in winter hours it never planned for -- which is what the $+46$\,\% regret \emph {is}, physically}{table.caption.31}{}}
