\newlabel{subsec:generalis}{{3.9}{16}{Secondary finding: generalisability and out-of-sample prediction}{subsection.3.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Extended-physics effects, each isolated (R1.3) and reported against its method and a rigorous bound (R2.3). Trunk pressure and the linearisation error are \emph  {solved}: pressure to a $0.01$\,\% gap, and the PWL-vs-native temperature error by a fix-and-relax nonlinear re-solve (the MILP schedule is re-costed under native, non-linearised temperature propagation on a winter and an autumn week, both converged to $\le 0.03$\,\% gap). Node temperature propagation is additionally reported through the validated nonlinear forward reference -- \emph  {not} its solved MILP, whose free-variable temperature form is degenerate (the optimiser floors the supply temperature for $\sim $91\,\% of hours, collapsing losses), consistent with \S  2.4/\S  4.7. Transport delay reproduces $\ensuremath  {\mathrm  {L3}}$ \emph  {identically} -- to the last digit ($+0.00$\,\%): trunk travel times are sub-hourly, so on the hourly grid the delay is a zero-timestep shift that storage absorbs. Every effect is far below the loss main effect, and the linearisation error is small \emph  {and negative} -- the PWL model slightly over-states cost.}}{17}{table.caption.36}\protected@file@percent }
\newlabel{tab:linearisation}{{12}{17}{Extended-physics effects, each isolated (R1.3) and reported against its method and a rigorous bound (R2.3). Trunk pressure and the linearisation error are \emph {solved}: pressure to a $0.01$\,\% gap, and the PWL-vs-native temperature error by a fix-and-relax nonlinear re-solve (the MILP schedule is re-costed under native, non-linearised temperature propagation on a winter and an autumn week, both converged to $\le 0.03$\,\% gap). Node temperature propagation is additionally reported through the validated nonlinear forward reference -- \emph {not} its solved MILP, whose free-variable temperature form is degenerate (the optimiser floors the supply temperature for $\sim $91\,\% of hours, collapsing losses), consistent with \S 2.4/\S 4.7. Transport delay reproduces $\Lthree $ \emph {identically} -- to the last digit ($+0.00$\,\%): trunk travel times are sub-hourly, so on the hourly grid the delay is a zero-timestep shift that storage absorbs. Every effect is far below the loss main effect, and the linearisation error is small \emph {and negative} -- the PWL model slightly over-states cost}{table.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Balanced-design analysis of variance of the loss burden across the 135 synthetic networks (full $3\times 5\times 3\times 3$ factorial, so the sums of squares are unambiguous). Trunk pipe length dominates; the loss main effect is $\ge $97\,\% of the cost gap on every network regardless of factor, and the topology main effect stays within $\pm $2.4\,\%, so the decomposition conclusion is a property of the design, not of any one factor level.}}{17}{table.caption.37}\protected@file@percent }
\newlabel{tab:synthanova}{{13}{17}{Balanced-design analysis of variance of the loss burden across the 135 synthetic networks (full $3\times 5\times 3\times 3$ factorial, so the sums of squares are unambiguous). Trunk pipe length dominates; the loss main effect is $\ge $97\,\% of the cost gap on every network regardless of factor, and the topology main effect stays within $\pm $2.4\,\%, so the decomposition conclusion is a property of the design, not of any one factor level}{table.caption.37}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Out-of-sample prediction of the cost gap (loss burden) from observable network properties. The estimator is fitted on the synthetic networks up to 15\,km trunk length (train $R^2=0.999$) and tested on the held-out longer networks, an \emph  {extrapolation} beyond the fitted range. It predicts the 30\,km networks to within a few points and degrades at the extreme 50\,km extrapolation (held-out MAPE 19\,\%), which we report as given.}}{17}{table.caption.38}\protected@file@percent }
\newlabel{tab:prediction}{{14}{17}{Out-of-sample prediction of the cost gap (loss burden) from observable network properties. The estimator is fitted on the synthetic networks up to 15\,km trunk length (train $R^2=0.999$) and tested on the held-out longer networks, an \emph {extrapolation} beyond the fitted range. It predicts the 30\,km networks to within a few points and degrades at the extreme 50\,km extrapolation (held-out MAPE 19\,\%), which we report as given}{table.caption.38}{}}
