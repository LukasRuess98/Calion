[run]
# Coverage.py configuration

# Source packages to measure
source = energis

# Files to omit from coverage
omit =
    # Test files
    */tests/*
    */test_*.py
    # Setup and configuration
    setup.py
    */setup.py
    # Virtual environments
    */venv/*
    */.venv/*
    */env/*
    # Version files
    */__version__.py
    # Init files (often just imports)
    */__init__.py
    # ── Visualization / Dashboard (optional UI, not core logic) ──
    energis/io/dashboard/*
    energis/io/plotter.py
    energis/io/plot_utils.py
    energis/io/publication_plotter.py
    energis/io/publication_exporter.py
    energis/io/report_generator.py
    energis/io/workflow_browser.py
    energis/io/model_inspector.py
    # ── Export adapters (thin wrappers) ──
    energis/io/exporter.py
    energis/io/unified_exporter.py
    energis/io/thermal_network_exporter.py
    energis/io/network_loader.py
    # ── Optional subsystems not yet in core test scope ──
    energis/economics/*
    energis/comparison/*
    energis/forecasting/*
    energis/analysis/*
    # ── v2 config pipeline (not yet integrated into main workflow) ──
    energis/config/config_manager.py
    energis/config/loader_v2.py
    # ── MPC module (under development, not yet covered) ──
    energis/run/mpc.py

# Enable branch coverage
branch = True

# Run coverage in parallel mode (useful for multiprocessing)
parallel = False

[report]
# Reporting options

# Precision for coverage percentage
precision = 2

# Show lines that weren't executed
show_missing = True

# Skip covered files in report
skip_covered = False

# Skip empty files
skip_empty = True

# Fail if coverage is under this threshold
fail_under = 60

# Exclude certain lines from coverage
exclude_lines =
    # Standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__
    def __str__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:
    if TYPE_CHECKING:

    # Don't complain about abstract methods
    @abstractmethod
    @abc.abstractmethod

    # Don't complain about pass statements
    pass

    # Don't complain about ellipsis in protocol/stub definitions
    \.\.\.

[html]
# HTML report options
directory = htmlcov
title = EnerGIS Coverage Report

[xml]
# XML report for CI/CD integration
output = coverage.xml
